<?xml version="1.0" ?>
<!-- VISPA Dual-Arm Crawling Robot — Corrected URDF (7-DOF arms)
     Fixes applied:
       1. Added <link name="world"/> (was referenced but undefined)
       2. Fixed tool_a / tool_b : self-closing tag prevented inertial assignment
       3. Kept world-link0 fixed joint for URDF compatibility;
          for floating-base use:
            - Pinocchio: buildModelFromUrdf(..., JointModelFreeFlyer())
            - MuJoCo:   use the companion VISPA_crawling.xml (MJCF) instead
       4. Added an SEW-redundant elbow-swivel joint per arm
          (Joint_swivel_{a,b}) between Joint_2 and Joint_3, axis
          along the shoulder-elbow direction (Link_2's x-axis).
          Per spec §4.9.6, this matches the standard 7-DOF VISPA
          layout used in the MIRROR project (Mishra et al., 2022).
          Each arm is now 7-DOF → total actuated joints = 14
          (Pinocchio nq = 21, nv = 20 with free-flyer base).
-->
<robot name="VISPA">

  <!-- Implicit world frame link (required by world-link0 joint) -->
  <link name="world"/>

  <!-- ==================== TORSO ==================== -->
  <link name="Link_0">
    <visual>
      <geometry>
        <mesh filename="meshes/torso.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/torso.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="40.0"/>
      <inertia ixx="0.17980580" ixy="0" ixz="0"
               iyy="0.17982988" iyz="0"
               izz="0.24241079"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <!-- ==================== ARM A ==================== -->
  <link name="Link_1_a">
    <visual>
      <geometry><mesh filename="meshes/link1.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link1.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="2.328"/>
      <inertia ixx="0.012" ixy="0" ixz="0"
               iyy="0.007" iyz="0.003" izz="0.008"/>
      <origin xyz="0 -0.029 -0.043"/>
    </inertial>
  </link>

  <link name="Link_2_a">
    <visual>
      <geometry><mesh filename="meshes/link2_0_5.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link2_0_5.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="3.995"/>
      <inertia ixx="0.010" ixy="0" ixz="0"
               iyy="0.578" iyz="0" izz="0.574"/>
      <origin xyz="0.25 0 0.142"/>
    </inertial>
  </link>

  <!-- Elbow-swivel dummy link for arm A (7-DOF SEW redundancy) -->
  <link name="Link_2_swivel_a">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <link name="Link_3_a">
    <visual>
      <geometry><mesh filename="meshes/link3.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link3.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="2.328"/>
      <inertia ixx="0.012" ixy="0" ixz="0"
               iyy="0.008" iyz="0.003" izz="0.007"/>
      <origin xyz="0 0.043 0.029"/>
    </inertial>
  </link>

  <link name="Link_4_a">
    <visual>
      <geometry><mesh filename="meshes/link4.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link4.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="3.157"/>
      <inertia ixx="0.199" ixy="0" ixz="0"
               iyy="0.193" iyz="0.01" izz="0.01"/>
      <origin xyz="0 -0.043 -0.210"/>
    </inertial>
  </link>

  <link name="Link_5_a">
    <visual>
      <geometry><mesh filename="meshes/link5.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link5.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="2.695"/>
      <inertia ixx="0.029" ixy="0" ixz="0"
               iyy="0.006" iyz="-0.001" izz="0.027"/>
      <origin xyz="0 0.125 -0.007"/>
    </inertial>
  </link>

  <link name="Link_6_a">
    <visual>
      <geometry><mesh filename="meshes/link6.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link6.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.924"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.001"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <!-- FIX: was <link name="tool_a"/> (self-closing → inertial orphaned) -->
  <link name="tool_a">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <!-- ==================== ARM B ==================== -->
  <link name="Link_1_b">
    <visual>
      <geometry><mesh filename="meshes/link1.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link1.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="2.328"/>
      <inertia ixx="0.012" ixy="0" ixz="0"
               iyy="0.007" iyz="0.003" izz="0.008"/>
      <origin xyz="0 -0.029 -0.043"/>
    </inertial>
  </link>

  <link name="Link_2_b">
    <visual>
      <geometry><mesh filename="meshes/link2_0_5.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link2_0_5.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="3.995"/>
      <inertia ixx="0.010" ixy="0" ixz="0"
               iyy="0.578" iyz="0" izz="0.574"/>
      <origin xyz="0.25 0 0.142"/>
    </inertial>
  </link>

  <!-- Elbow-swivel dummy link for arm B (7-DOF SEW redundancy) -->
  <link name="Link_2_swivel_b">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <link name="Link_3_b">
    <visual>
      <geometry><mesh filename="meshes/link3.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link3.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="2.328"/>
      <inertia ixx="0.012" ixy="0" ixz="0"
               iyy="0.008" iyz="0.003" izz="0.007"/>
      <origin xyz="0 0.043 0.029"/>
    </inertial>
  </link>

  <link name="Link_4_b">
    <visual>
      <geometry><mesh filename="meshes/link4.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link4.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="3.157"/>
      <inertia ixx="0.199" ixy="0" ixz="0"
               iyy="0.193" iyz="0.01" izz="0.01"/>
      <origin xyz="0 -0.043 -0.210"/>
    </inertial>
  </link>

  <link name="Link_5_b">
    <visual>
      <geometry><mesh filename="meshes/link5.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link5.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="2.695"/>
      <inertia ixx="0.029" ixy="0" ixz="0"
               iyy="0.006" iyz="-0.001" izz="0.027"/>
      <origin xyz="0 0.125 -0.007"/>
    </inertial>
  </link>

  <link name="Link_6_b">
    <visual>
      <geometry><mesh filename="meshes/link6.stl"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/link6.stl"/></geometry>
    </collision>
    <inertial>
      <mass value="0.924"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.001"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <!-- FIX: was <link name="tool_b"/> (same self-closing bug) -->
  <link name="tool_b">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <!-- ==================== JOINTS ==================== -->

  <!-- Torso fixed to world (for URDF compat; ignored in floating-base loaders) -->
  <joint name="world-link0" type="fixed">
    <parent link="world"/>
    <child link="Link_0"/>
  </joint>

  <!-- ARM A -->
  <joint name="Joint_1_a" type="revolute">
    <parent link="Link_0"/>
    <child link="Link_1_a"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="-0.240 0.41469 -0.064498" rpy="-2.0944 0 0.5236"/>
  </joint>

  <joint name="Joint_2_a" type="revolute">
    <parent link="Link_1_a"/>
    <child link="Link_2_a"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0 0" rpy="1.57079632679 -1.57079632679 0"/>
  </joint>

  <!-- Joint_swivel_a: SEW-redundant upper-arm roll (spec §4.9.6).
       Axis = Link_2_a's x-axis (shoulder→elbow direction).
       Origin is at the elbow, i.e. offset (0.5, 0, 0) from Link_2_a. -->
  <joint name="Joint_swivel_a" type="revolute">
    <parent link="Link_2_a"/>
    <child link="Link_2_swivel_a"/>
    <axis xyz="1 0 0"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="Joint_3_a" type="revolute">
    <parent link="Link_2_swivel_a"/>
    <child link="Link_3_a"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0 0" rpy="0 0 -1.57079632679"/>
  </joint>

  <joint name="Joint_4_a" type="revolute">
    <parent link="Link_3_a"/>
    <child link="Link_4_a"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0.65 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="Joint_5_a" type="revolute">
    <parent link="Link_4_a"/>
    <child link="Link_5_a"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0 -0.1" rpy="1.57079632679 0 0"/>
  </joint>

  <joint name="Joint_6_a" type="revolute">
    <parent link="Link_5_a"/>
    <child link="Link_6_a"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0.325 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="joint_6-tool_a" type="fixed">
    <parent link="Link_6_a"/>
    <child link="tool_a"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ARM B -->
  <joint name="Joint_1_b" type="revolute">
    <parent link="Link_0"/>
    <child link="Link_1_b"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="-0.240 -0.41469 -0.064498" rpy="1.047197551 3.14159265359 -0.5236"/>
  </joint>

  <joint name="Joint_2_b" type="revolute">
    <parent link="Link_1_b"/>
    <child link="Link_2_b"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0 0" rpy="1.57079632679 -1.57079632679 0"/>
  </joint>

  <!-- Joint_swivel_b: SEW-redundant upper-arm roll (spec §4.9.6). -->
  <joint name="Joint_swivel_b" type="revolute">
    <parent link="Link_2_b"/>
    <child link="Link_2_swivel_b"/>
    <axis xyz="1 0 0"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="Joint_3_b" type="revolute">
    <parent link="Link_2_swivel_b"/>
    <child link="Link_3_b"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0 0" rpy="0 0 -1.57079632679"/>
  </joint>

  <joint name="Joint_4_b" type="revolute">
    <parent link="Link_3_b"/>
    <child link="Link_4_b"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0.65 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="Joint_5_b" type="revolute">
    <parent link="Link_4_b"/>
    <child link="Link_5_b"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0 -0.1" rpy="1.57079632679 0 0"/>
  </joint>

  <joint name="Joint_6_b" type="revolute">
    <parent link="Link_5_b"/>
    <child link="Link_6_b"/>
    <axis xyz="0 0 1"/>
    <limit effort="50" lower="-3.14159265359" upper="3.14159265359" velocity="0.09395689"/>
    <origin xyz="0 0.325 0" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="joint_6-tool_b" type="fixed">
    <parent link="Link_6_b"/>
    <child link="tool_b"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
